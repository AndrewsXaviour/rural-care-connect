# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Assistant (Gemini) — SERVER-SIDE ONLY (in Vercel env vars, NOT client)
# GEMINI_API_KEY=

# AWS Location Service — SERVER-SIDE ONLY (in Vercel env vars, NOT client)
# AWS_LOCATION_SERVICE_API_KEY=
# AWS_PLACES_INDEX=

# Aadhaar Encryption (32-char hex key for AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_AADHAAR_ENCRYPTION_KEY=

# Razorpay (publishable key only - secret stays server-side)
# Get keys: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=

# Vonage SMS Gateway (for Emergency SOS)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=
